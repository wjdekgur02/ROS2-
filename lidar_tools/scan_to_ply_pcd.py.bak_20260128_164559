#!/usr/bin/env python3
import argparse
import os
import signal
import time
import threading
from datetime import datetime

import numpy as np

import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, HistoryPolicy
from sensor_msgs.msg import LaserScan


def write_ply_ascii(path, xyz, intensity=None):
    n = xyz.shape[0]
    with open(path, "w") as f:
        f.write("ply\n")
        f.write("format ascii 1.0\n")
        f.write(f"element vertex {n}\n")
        f.write("property float x\nproperty float y\nproperty float z\n")
        if intensity is not None:
            f.write("property float intensity\n")
        f.write("end_header\n")
        if intensity is None:
            for p in xyz:
                f.write(f"{p[0]} {p[1]} {p[2]}\n")
        else:
            for p, it in zip(xyz, intensity):
                f.write(f"{p[0]} {p[1]} {p[2]} {it}\n")


def write_pcd_ascii(path, xyz, intensity=None):
    n = xyz.shape[0]
    has_i = intensity is not None
    fields = "x y z intensity" if has_i else "x y z"
    size = "4 4 4 4" if has_i else "4 4 4"
    typ  = "F F F F" if has_i else "F F F"
    cnt  = "1 1 1 1" if has_i else "1 1 1"

    with open(path, "w") as f:
        f.write("# .PCD v0.7 - Point Cloud Data file format\n")
        f.write("VERSION 0.7\n")
        f.write(f"FIELDS {fields}\n")
        f.write(f"SIZE {size}\n")
        f.write(f"TYPE {typ}\n")
        f.write(f"COUNT {cnt}\n")
        f.write(f"WIDTH {n}\n")
        f.write("HEIGHT 1\n")
        f.write("VIEWPOINT 0 0 0 1 0 0 0\n")
        f.write(f"POINTS {n}\n")
        f.write("DATA ascii\n")
        if not has_i:
            for p in xyz:
                f.write(f"{p[0]} {p[1]} {p[2]}\n")
        else:
            for p, it in zip(xyz, intensity):
                f.write(f"{p[0]} {p[1]} {p[2]} {it}\n")


class ScanToCloudSaver(Node):
    def __init__(self, scan_topic, height_m, duration_s, out_prefix, scan_skip, point_skip, use_intensity, countdown_s):
        super().__init__("scan_to_cloud_saver")

        self.scan_topic = scan_topic
        self.height_m = float(height_m)
        self.duration_s = float(duration_s)
        self.out_prefix = out_prefix
        self.scan_skip = max(1, int(scan_skip))
        self.point_skip = max(1, int(point_skip))
        self.use_intensity = bool(use_intensity)
        self.countdown_s = max(0, int(countdown_s))

        # ✅ /scan QoS: BEST_EFFORT
        qos = QoSProfile(
            history=HistoryPolicy.KEEP_LAST,
            depth=10,
            reliability=ReliabilityPolicy.BEST_EFFORT,
        )
        self.sub = self.create_subscription(LaserScan, self.scan_topic, self.on_scan, qos)

        self.armed = False          # 엔터 + 카운트다운 끝나면 True
        self.t0_ns = None

        self.scan_count = 0
        self.xyz_chunks = []
        self.int_chunks = []
        self.total_points = 0
        self.finished = False

        self.get_logger().info(f"Subscribe: {self.scan_topic}")
        self.get_logger().info(f"Time-based Z: 0 -> {self.height_m} m over {self.duration_s} s")
        self.get_logger().info(f"scan_skip={self.scan_skip}, point_skip={self.point_skip}, intensity={self.use_intensity}")
        self.get_logger().info("준비되면 이 터미널에서 Enter 누르면 3-2-1 후 시작합니다. (Ctrl+C는 저장 후 종료)")

    def arm_with_countdown(self):
        # 외부 스레드에서 호출
        for i in range(self.countdown_s, 0, -1):
            self.get_logger().info(str(i))
            time.sleep(1.0)
        self.armed = True
        self.get_logger().info("START (stacking begins now)")

    def current_z(self, now_ns):
        t = (now_ns - self.t0_ns) / 1e9
        a = min(max(t / self.duration_s, 0.0), 1.0)
        return self.height_m * a, a

    def on_scan(self, msg: LaserScan):
        if self.finished:
            return

        # 아직 시작(ARM) 안 했으면 스캔은 그냥 버림
        if not self.armed:
            return

        self.scan_count += 1
        if (self.scan_count % self.scan_skip) != 0:
            return

        now_ns = self.get_clock().now().nanoseconds
        if self.t0_ns is None:
            self.t0_ns = now_ns
            self.get_logger().info("t0 set (start stacking)")

        z, alpha = self.current_z(now_ns)

        ranges = np.array(msg.ranges, dtype=np.float32)
        n = ranges.shape[0]
        angles = msg.angle_min + np.arange(n, dtype=np.float32) * msg.angle_increment

        valid = np.isfinite(ranges) & (ranges >= msg.range_min) & (ranges <= msg.range_max)
        idx = np.where(valid)[0]
        if idx.size == 0:
            return

        idx = idx[::self.point_skip]
        r = ranges[idx]
        a = angles[idx]

        x = r * np.cos(a)
        y = r * np.sin(a)
        zz = np.full_like(x, z)

        xyz = np.stack([x, y, zz], axis=1).astype(np.float32)
        self.xyz_chunks.append(xyz)
        self.total_points += xyz.shape[0]

        if self.use_intensity and len(msg.intensities) == n:
            intens = np.array(msg.intensities, dtype=np.float32)[idx]
            self.int_chunks.append(intens)

        if (self.scan_count % (self.scan_skip * 20)) == 0:
            self.get_logger().info(f"alpha={alpha:.3f}, z={z:.3f}m, points={self.total_points}")

        if alpha >= 1.0:
            self.get_logger().info("Reached target height (alpha=1). Saving...")
            self.save_and_finish()

    def save_and_finish(self):
        if self.finished:
            return
        self.finished = True

        if self.total_points == 0:
            self.get_logger().error("No points collected. Nothing to save.")
            return

        xyz = np.concatenate(self.xyz_chunks, axis=0)

        intensity = None
        if self.use_intensity and len(self.int_chunks) == len(self.xyz_chunks) and len(self.int_chunks) > 0:
            intensity = np.concatenate(self.int_chunks, axis=0)
            if intensity.shape[0] != xyz.shape[0]:
                intensity = None

        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        ply_path = f"{self.out_prefix}_{ts}.ply"
        pcd_path = f"{self.out_prefix}_{ts}.pcd"
        os.makedirs(os.path.dirname(ply_path) or ".", exist_ok=True)

        write_ply_ascii(ply_path, xyz, intensity=intensity)
        write_pcd_ascii(pcd_path, xyz, intensity=intensity)

        self.get_logger().info(f"Saved PLY: {ply_path}")
        self.get_logger().info(f"Saved PCD: {pcd_path}")
        self.get_logger().info("Done.")
        rclpy.shutdown()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--scan_topic", default="/scan")
    ap.add_argument("--height_m", type=float, default=0.40)
    ap.add_argument("--duration_s", type=float, default=600.0)
    ap.add_argument("--out_prefix", default=os.path.expanduser("~/cloud/lidar_cloud"))
    ap.add_argument("--scan_skip", type=int, default=1)
    ap.add_argument("--point_skip", type=int, default=1)
    ap.add_argument("--intensity", action="store_true")
    ap.add_argument("--countdown", type=int, default=3)  # ✅ 3-2-1
    args = ap.parse_args()

    rclpy.init()
    node = ScanToCloudSaver(
        scan_topic=args.scan_topic,
        height_m=args.height_m,
        duration_s=args.duration_s,
        out_prefix=os.path.expanduser(args.out_prefix),
        scan_skip=args.scan_skip,
        point_skip=args.point_skip,
        use_intensity=args.intensity,
        countdown_s=args.countdown,
    )

    def sigint_handler(sig, frame):
        node.get_logger().info("SIGINT: Saving and exiting...")
        node.save_and_finish()

    signal.signal(signal.SIGINT, sigint_handler)

    # ✅ Enter를 기다렸다가 카운트다운 후 ARM
    def wait_and_arm():
        try:
            input("")  # Enter
        except Exception:
            return
        node.arm_with_countdown()

    threading.Thread(target=wait_and_arm, daemon=True).start()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        node.get_logger().info("KeyboardInterrupt: Saving and exiting...")
        node.save_and_finish()

    node.destroy_node()


if __name__ == "__main__":
    main()
